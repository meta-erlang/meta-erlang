[doc Test if livebook build and image is working]

[include ../support/luxinc/utils.luxinc]
[include ../support/luxinc/bitbake-setup.luxinc]
[include ../support/luxinc/meta_erlang.luxinc]

[shell cmd-qemuarm64]
    [invoke bitbake-setup-prepare-env]

    [invoke testimage livebook-image "image example with livebook" livebook poky qemuarm64]

[shell cmd-qemux86-64]
    [invoke bitbake-setup-prepare-env]

    [invoke testimage livebook-image "image example with livebook" livebook poky qemux86-64]