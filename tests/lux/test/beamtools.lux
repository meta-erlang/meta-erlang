[doc Test if beamtools is able to produce a SDK]

[include ../support/luxinc/utils.luxinc]
[include ../support/luxinc/bitbake-setup.luxinc]

[macro get_toolchain_script]
    !bitbake-getvar -r beamtools-tarball SDK_DEPLOY
    ?SDK_DEPLOY="(.*)"
    [local SDK_DEPLOY=$1]
    [invoke wait-build-ok]

    !bitbake-getvar -r beamtools-tarball TOOLCHAIN_OUTPUTNAME
    ?TOOLCHAIN_OUTPUTNAME="(.*)"
    [local TOOLCHAIN_OUTPUTNAME=$1]
    [invoke wait-build-ok]
[endmacro]

[macro setup_toolchain tmpdir_toolchain toolchain_script]
    # install toolchain
    !${toolchain_script} -y -d ${tmpdir_toolchain}
    [invoke wait-ok 45]

    # source it and run a basic validation
    !. ${tmpdir_toolchain}/environment-setup-x86_64-pokysdk-linux
    [invoke ok]
[endmacro]

[macro check_erl]
    [timeout 10]

    !erl
    ?Erlang/OTP
    ?Eshell
    ?>

    !erlang:system_info(system_version).
    ?Erlang/OTP
    ?>

    !application:ensure_all_started(crypto).
    ?>
    !crypto:info().
    ?cryptolib_version_compiled => "OpenSSL 4.*",
    ?cryptolib_version_linked => "OpenSSL 4.*",
    ?>

    !halt().
    [invoke ok]
[endmacro]

[shell setup]
    # create a temp folder for toolchain installation
    !mktemp -d
    ?^(/tmp.*)
    [global TMPDIR_TOOLCHAIN_NO_OPENGL=$1]
    [invoke ok]

    !mktemp -d
    ?^(/tmp.*)
    [global TMPDIR_TOOLCHAIN_OPENGL=$1]
    [invoke ok]

    !${_CTRL_D_}
    [endshell 0]

[shell beamtools-no-opengl]
    [invoke bitbake-setup-prepare-env]

    [invoke bitbake-setup "beamtools no opengl" beamtools-no-opengl distro/poky machine/qemuarm64]

    !bitbake beamtools-tarball -c cleansstate
    [invoke wait-build-ok]

    !bitbake beamtools-tarball
    [invoke wait-build-ok]

    [invoke get_toolchain_script]
    
    [global TOOLCHAIN_SCRIPT_NO_OPENGL=${SDK_DEPLOY}/${TOOLCHAIN_OUTPUTNAME}.sh]

[shell beamtools-no-opengl-install]
    [invoke setup_toolchain ${TMPDIR_TOOLCHAIN_NO_OPENGL} ${TOOLCHAIN_SCRIPT_NO_OPENGL}]

    [invoke check_erl]

[shell beamtools-opengl]
    [invoke bitbake-setup-prepare-env]

    [invoke bitbake-setup "beamtools opengl" beamtools-opengl distro/poky machine/qemuarm64]

    !bitbake beamtools-tarball -c cleansstate
    [invoke wait-build-ok]

    !bitbake beamtools-tarball
    [invoke wait-build-ok]

    [invoke get_toolchain_script]
    
    [global TOOLCHAIN_SCRIPT_OPENGL=${SDK_DEPLOY}/${TOOLCHAIN_OUTPUTNAME}.sh]

[shell beamtools-opengl-install]
    [invoke setup_toolchain ${TMPDIR_TOOLCHAIN_OPENGL} ${TOOLCHAIN_SCRIPT_OPENGL}]

    [invoke check_erl]

[cleanup]
    !rm -rf ${TMPDIR_TOOLCHAIN_NO_OPENGL}
    [invoke ok]
    !rm -rf ${TMPDIR_TOOLCHAIN_OPENGL}
    [invoke ok]