[doc Test if rabbitmq build and image is working]

[include ../support/luxinc/utils.luxinc]
[include ../support/luxinc/bitbake-setup.luxinc]
[include ../support/luxinc/meta_erlang.luxinc]

[shell cmd-qemuarm64]
    [invoke bitbake-setup-prepare-env]

    [invoke testimage rabbitmq-image "image example with rabbitmq" rabbitmq poky qemuarm64]

[shell cmd-qemux86-64]
    [invoke bitbake-setup-prepare-env]

    [invoke testimage rabbitmq-image "image example with rabbitmq" rabbitmq poky qemux86-64]